{
  "name": "easy.env",
  "version": "1.0.0",
  "description": "Easy.env is a tiny, type-safe way to read required or optional values from process.env",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsx tests/test.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvachette/easy.env.git"
  },
  "author": "Donatien Vachette",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dvachette/easy.env/issues"
  },
  "homepage": "https://github.com/dvachette/easy.env#readme",
  "keywords": [
    "env",
    "environment",
    "process.env",
    "config",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "tsup": "^8.5.1"
  }
}